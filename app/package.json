{
  "name": "fonotheek",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fonotheek-app voor de luisterbar van Fonos (Beeld & Geluid)",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "import:muziekweb": "tsx scripts/import-muziekweb.ts",
    "laad:naslag": "tsx scripts/laad-naslag.ts",
    "import:collectie": "tsx scripts/import-collectie.ts",
    "demo": "tsx scripts/demo.ts",
    "gebruiker": "tsx scripts/gebruiker.ts",
    "spotify:koppel": "tsx scripts/spotify-koppel.ts",
    "spotify:export": "tsx scripts/spotify-export.ts",
    "vercel-build": "vite build && node scripts/bouw-vercel.mjs && tsx scripts/vercel-vul.ts",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@hono/node-server": "^2.1.11",
    "@vercel/blob": "^2.9.0",
    "exceljs": "^4.4.0",
    "hono": "^4.13.19",
    "jszip": "^3.10.2",
    "lucide-react": "^1.77.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.17",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "playwright-core": "1.56.1"
  }
}
